# Database (docker compose up -d db gives you this one)
DATABASE_URL="postgresql://haat:haat@localhost:5432/haat?schema=public"

# Server
PORT=4000
# Public URL of the web app, used for payment redirects and links in notifications
WEB_URL="http://localhost:3000"
# Public URL of this API as the payment gateway sees it (IPN callbacks)
API_PUBLIC_URL="http://localhost:4000"

# Auth — change JWT_SECRET in every real environment
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Payments: "mock" (local testing page) or "sslcommerz"
PAYMENT_PROVIDER=mock
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_SANDBOX=true

# SMS: "console" prints messages to the API log (and Admin → Audit log → Text messages);
# "sslwireless" sends them through SSL Wireless SMS Plus
SMS_PROVIDER=console
SSL_SMS_API_TOKEN=""
SSL_SMS_SID=""

# Couriers. A courier without its keys shows as "Not set up" and can't be booked.
# Webhook URLs to paste into each merchant panel are shown in Admin → Settings.
# Steadfast: API key + secret from the merchant panel; the webhook "Auth token" you set there
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_TOKEN=""
# Pathao: merchant API client + login, pickup store id, webhook secret
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""
PATHAO_SANDBOX=true
PATHAO_WEBHOOK_SECRET=""
# RedX: API access token; a secret of your choice for the callback URL (?token=)
REDX_ACCESS_TOKEN=""
REDX_SANDBOX=true
REDX_PICKUP_STORE_ID=""
REDX_WEBHOOK_TOKEN=""
# The test courier (pretend consignments) is on outside production; COURIER_TEST=true turns it on in production
COURIER_TEST=false

# Uploaded images are stored here and served at /uploads
UPLOAD_DIR="./uploads"
